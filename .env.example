# Environment variables for jdreksler.com
# Copy this file to .env and fill in values.

# REQUIRED in production — generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to 1 to enable debug mode (never in production)
# DJANGO_DEBUG=1

# Optional: MySQL/Railway database variables (omit for SQLite)
# MYSQL_URL=mysql://user:pass@host:3306/dbname   # Railway standard; overrides the individual vars below
# MYSQLHOST=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQLPORT=3306

# Canonical public origin used for canonical links, sitemap, and JSON-LD
# (never the request Host). Defaults to https://jdreksler.com
# DJANGO_SITE_URL=https://jdreksler.com

# GA4 measurement ID; omitted (or empty) means no analytics requests
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Enable the Django admin behind a secret URL path (recommended), e.g.:
#   DJANGO_ADMIN_URL=mysecretadmin  → admin at /mysecretadmin/
# Unset/empty = admin disabled (404)
# DJANGO_ADMIN_URL=

# Production security toggles (only read when DJANGO_DEBUG != 1):
# DJANGO_SECURE_SSL=1                 # HTTPS redirect (default on)
# DJANGO_HSTS_SECONDS=31536000        # HSTS max-age (default 1 year)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://jdreksler.com,https://www.jdreksler.com
